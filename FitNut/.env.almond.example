# Merge these settings into the server's private environment. Never commit populated credentials.
ALMOND_ENABLED=false
ALMOND_GATEWAY_URL=http://127.0.0.1:8001
ALMOND_GATEWAY_TOKEN=
ALMOND_WRITER_MODEL=
# Existing vendor credential file on the gateway host, loaded only by the sidecar:
ALMOND_VENDOR_ENV=C:/broll-api/geography/.env
ALMOND_QWEN_REGION=us
# Required variable names in that file: DASHSCOPE_API_KEY, DEEPSEEK_API_KEY, ZAI_API_KEY, OPENROUTER_API_KEY
